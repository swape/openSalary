{
  "name": "opensalary",
  "type": "module",
  "private": true,
  "author": "Alireza Balouch",
  "scripts": {
    "data:update": "node scripts/update-ssb.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write \"**/*.{astro,css,js,mjs,ts,json}\"",
    "format:check": "prettier --check \"**/*.{astro,css,js,mjs,ts,json}\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "astro": "^7.4.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "chartjs-plugin-zoom": "^2.2.0"
  }
}
