---
import { Font } from 'astro:assets'
import '../styles/chart.css'
import '../styles/colors.css'

interface Props {
  title: string
  description: string
  lang?: string
}

const { title, description, lang = 'nb' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Font cssVariable="--font-dm-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-ibm-plex-mono" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-material-symbols-rounded" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: var(--font-dm-sans), sans-serif;
    color: var(--color-text);
    background: var(--color-background);
    font-synthesis: none;
    line-height: 1.6;
  }
  .material-symbols-rounded {
    font-family: var(--font-material-symbols-rounded);
    font-weight: 400;
    font-style: normal;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    direction: ltr;
    font-feature-settings: 'liga';
    -webkit-font-feature-settings: 'liga';
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
    -webkit-font-smoothing: antialiased;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none;
  }
  body {
    margin: 0;
  }
  main {
    max-width: 1160px;
    margin: auto;
    padding: 3rem 1.25rem;
  }
  header {
    margin-bottom: 2rem;
    max-width: 760px;
  }
  h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    letter-spacing: -0.05em;
    margin: 0;
    line-height: 1.15;
  }
  h2 {
    margin: 0 0 1rem;
    font-size: 1.4rem;
    line-height: 1.35;
  }
  h3 {
    font-size: 1.05rem;
    margin-top: 1.6rem;
  }
  p {
    margin: 0.75rem 0;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .intro {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
  salary-calculator {
    display: block;
  }
  .calculator-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .panel {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    min-width: 0;
  }
  .fields {
    display: grid;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.95rem;
    margin-block-end: 0.6rem;
  }
  button {
    font: inherit;
  }
  :focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  fieldset {
    margin: 1.5rem 0;
    border: 0;
    padding: 0;
  }
  legend {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }
  .fields .hint {
    margin-top: -0.5rem;
  }
  details {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  summary {
    cursor: pointer;
    font-weight: 650;
    min-height: 44px;
  }
  button {
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: 700;
    cursor: pointer;
    min-height: 44px;
  }
  button:hover {
    background: var(--color-primary-hover);
  }
  [data-error] {
    color: var(--color-error);
    background: var(--color-error-background);
    padding: 0.75rem;
    border-radius: 0.4rem;
  }
  .results {
    border-top: 4px solid var(--color-primary);
  }
  .salary {
    font-family: var(--font-ibm-plex-mono), monospace;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .secondary-result {
    font-weight: 600;
  }
  .source-note {
    background: var(--color-source-background);
    padding: 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  caption {
    text-align: left;
    color: var(--color-text-subtle);
    font-size: 0.85rem;
    margin-bottom: 0.65rem;
  }
  th,
  td {
    padding: 0.75rem 0.35rem;
    border-bottom: 1px solid var(--color-border);
    text-align: right;
  }
  th:first-child {
    text-align: left;
  }
  td {
    white-space: nowrap;
    font-family: var(--font-ibm-plex-mono), monospace;
  }
  small {
    display: block;
    font-weight: 400;
    color: var(--color-text-subtle);
  }
  tfoot {
    font-weight: 700;
  }
  .growth {
    margin-top: 1.5rem;
  }
  a {
    color: var(--color-primary);
    text-underline-offset: 0.15em;
  }
  footer {
    margin-top: 2rem;
    color: var(--color-text-subtle);
    font-size: 0.85rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    main {
      padding: 1.5rem 0.85rem;
    }
    .panel {
      padding: 1.15rem;
    }
  }
</style>
